<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Responsive Profile Cards</title>

    <!-- Bootstrap CSS -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>
        /* Box Model */
        .profile-card {
            position: relative; /* Badge এর জন্য */

            padding: 25px;
            margin: 10px;

            border: 1px solid #ddd;
            border-radius: 15px;

            /* Flexbox */
            display: flex;
            flex-direction: column;
            align-items: center;

            background-color: white;
        }

        /* Absolute Positioning */
        .badge-custom {
            position: absolute;
            top: 15px;
            right: 15px;
        }

        .profile-img {
            width: 100px;
            height: 100px;
            object-fit: cover;
        }

        /* CSS Grid */
        .card-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        /* Media Query */
        @media (max-width: 768px) {
            .card-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body class="bg-light">

    <div class="container py-5">

        <h1 class="text-center mb-4">
            My Team
        </h1>

        <!-- CSS Grid -->
        <div class="card-container">

            <!-- Card 1 -->
            <div class="profile-card shadow-sm">

                <!-- Absolute Badge -->
                <span class="badge text-bg-success badge-custom">
                    ONLINE
                </span>

                <img
                    src="https://i.pravatar.cc/150?img=12"
                    class="profile-img rounded-circle mb-3"
                    alt="Profile">

                <h3>Misbah Uddin</h3>

                <p class="text-muted">
                    Computer Science Student
                </p>

                <p>
                    💻 Web Developer
                </p>

                <button class="btn btn-primary">
                    View Profile
                </button>

            </div>


            <!-- Card 2 -->
            <div class="profile-card shadow-sm">

                <span class="badge text-bg-primary badge-custom">
                    NEW
                </span>

                <img
                    src="https://i.pravatar.cc/150?img=5"
                    class="profile-img rounded-circle mb-3"
                    alt="Profile">

                <h3>Rahim Ahmed</h3>

                <p class="text-muted">
                    Software Engineer
                </p>

                <p>
                    🚀 Backend Developer
                </p>

                <button class="btn btn-primary">
                    View Profile
                </button>

            </div>


            <!-- Card 3 -->
            <div class="profile-card shadow-sm">

                <span class="badge text-bg-success badge-custom">
                    ONLINE
                </span>

                <img
                    src="https://i.pravatar.cc/150?img=8"
                    class="profile-img rounded-circle mb-3"
                    alt="Profile">

                <h3>Karim Hasan</h3>

                <p class="text-muted">
                    UI/UX Designer
                </p>

                <p>
                    🎨 Creative Designer
                </p>

                <button class="btn btn-primary">
                    View Profile
                </button>

            </div>

        </div>

    </div>

</body>

</html>
