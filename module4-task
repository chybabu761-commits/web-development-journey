<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Cards</title>

    <style>
        /* Basic styling */
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background-color: #f2f2f2;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        /* CSS Grid - multiple cards */
        .card-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
            max-width: 1000px;
            margin: auto;
        }

        /* Profile Card */
        .card {
            position: relative; /* Needed for absolute badge */

            background-color: white;

            /* Box Model */
            padding: 25px;
            margin: 10px;

            border: 2px solid #ddd;
            border-radius: 15px;

            /* Flexbox */
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;

            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        /* Profile Image */
        .profile-img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;

            margin-bottom: 15px;
        }

        .card h2 {
            margin: 5px 0;
        }

        .card p {
            margin: 8px 0;
            color: #666;
        }

        /* Absolute Positioning */
        .badge {
            position: absolute;
            top: 15px;
            right: 15px;

            background-color: green;
            color: white;

            padding: 5px 10px;
            border-radius: 20px;

            font-size: 12px;
            font-weight: bold;
        }

        .btn {
            margin-top: 15px;
            padding: 10px 20px;

            border: none;
            border-radius: 8px;

            background-color: #007bff;
            color: white;

            cursor: pointer;
        }

        /* Media Query */
        @media (max-width: 768px) {
            .card-container {
                grid-template-columns: 1fr;
            }

            .card {
                margin: 10px 0;
            }
        }
    </style>
</head>

<body>

    <h1>My Team</h1>

    <div class="card-container">

        <!-- Card 1 -->
        <div class="card">
            <span class="badge">ONLINE</span>

            <img src="https://i.pravatar.cc/150?img=12"
                alt="Profile"
                class="profile-img">

            <h2>Misbah Uddin</h2>
            <p>Computer Science Student</p>
            <p>💻 Web Developer</p>

            <button class="btn">View Profile</button>
        </div>

        <!-- Card 2 -->
        <div class="card">
            <span class="badge">NEW</span>

            <img src="https://i.pravatar.cc/150?img=5"
                alt="Profile"
                class="profile-img">

            <h2>Rahim Ahmed</h2>
            <p>Software Engineer</p>
            <p>🚀 Backend Developer</p>

            <button class="btn">View Profile</button>
        </div>

        <!-- Card 3 -->
        <div class="card">
            <span class="badge">ONLINE</span>

            <img src="https://i.pravatar.cc/150?img=8"
                alt="Profile"
                class="profile-img">

            <h2>Karim Hasan</h2>
            <p>UI/UX Designer</p>
            <p>🎨 Creative Designer</p>

            <button class="btn">View Profile</button>
        </div>

    </div>

</body>

</html>
